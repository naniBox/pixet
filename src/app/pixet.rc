// Windows resource script - sets the .exe's icon (Explorer, taskbar, Alt+Tab). The
// first ICON resource in the file is what Explorer/the taskbar actually use as the
// executable's own icon, regardless of the numeric id - IDI_APP just names it.
//
// pixet.ico is generated from pixet.icns (itself generated by scripts/make-icon.py), not
// drawn separately. To regenerate it after pixet.icns changes: extract the icns file's
// ic11/ic12/ic07/ic13 PNG chunks (32/64/128/256px) and pack them into one
// multi-resolution .ico.
#define IDI_APP 101
IDI_APP ICON "pixet.ico"
