<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Bundle metadata template. CMake substitutes the MACOSX_BUNDLE_... placeholders below from
  the matching target properties set in CMakeLists.txt.

  Do not write a dollar-brace variable reference inside these comments: CMake expands the
  whole file, comments included, so a placeholder-looking string with a wildcard in it is a
  configure-time syntax error rather than documentation.

  This replaces CMake's built-in default template, which leaves CFBundleIdentifier and
  CFBundleName as empty strings. Empty is not merely untidy: macOS keys per-app state
  (window restore, and crucially the TCC grants that let the app read ~/Pictures and
  ~/Documents) off the bundle identifier, so an app without a stable one keeps re-asking
  for permission and never remembers its own window position.
-->
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleExecutable</key>
	<string>${MACOSX_BUNDLE_EXECUTABLE_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${MACOSX_BUNDLE_GUI_IDENTIFIER}</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundleDisplayName</key>
	<string>${MACOSX_BUNDLE_BUNDLE_NAME}</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>${MACOSX_BUNDLE_SHORT_VERSION_STRING}</string>
	<key>CFBundleVersion</key>
	<string>${MACOSX_BUNDLE_BUNDLE_VERSION}</string>
	<key>CFBundleIconFile</key>
	<string>${MACOSX_BUNDLE_ICON_FILE}</string>
	<key>NSHumanReadableCopyright</key>
	<string>${MACOSX_BUNDLE_COPYRIGHT}</string>

	<!-- Kept in step with CMAKE_OSX_DEPLOYMENT_TARGET (see the top-level CMakeLists). This
	     is the value Finder reads to refuse launching on an older OS with a clear message,
	     rather than letting dyld fail with a missing-symbol crash. -->
	<key>LSMinimumSystemVersion</key>
	<string>${CMAKE_OSX_DEPLOYMENT_TARGET}</string>

	<!-- Without this the window is rendered at 1x and scaled up by the compositor, which
	     for a photo viewer is the whole ballgame. -->
	<key>NSHighResolutionCapable</key>
	<true/>

	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.photography</string>

	<!-- Makes pixet offerable in Finder's "Open With" for images, video and folders.
	     LSHandlerRank is Alternate, not Owner: this should show up as a choice, never
	     quietly steal the default handler for every JPEG on the machine.

	     Only declared because the app actually honours it - main.cpp handles
	     QEvent::FileOpen and routes the path through MainWindow's existing
	     navigateToInput(), which resolves a file to its parent folder plus a selection.
	     Declaring document types without handling the event would put pixet in the
	     Open With menu and then appear to ignore the file. -->
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Image</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.image</string>
				<string>public.camera-raw-image</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Movie</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.movie</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
